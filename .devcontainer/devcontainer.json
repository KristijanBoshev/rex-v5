{
  "name": "rex-v5",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/rex-v5",
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y nodejs npm",
  "postCreateCommand": "curl -fsSL https://pi.dev/install.sh | bash && sudo ln -sf /home/vscode/.pi/agent/bin/pi /usr/local/bin/pi",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
